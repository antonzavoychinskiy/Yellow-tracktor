# Базовые значения sdkconfig для Модуля управления платформой.
# Точная сверка имён опций делается при первом запуске `idf.py menuconfig`
# на реальном тулчейне (пока не установлен — см. этап 10 роадмапа).

# Bluetooth не используется — экономия flash/RAM.
CONFIG_BT_ENABLED=n

# Задачный watchdog обязателен (FR-36): зависание основного цикла
# должно приводить к перезагрузке ESP32.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_PANIC=y

# Консоль на UART0 не используется под критичный обмен — TELEM2 подключён
# отдельными GPIO14/25 (п. 3.2) через свой драйвер UART, не через консоль.
CONFIG_ESP_CONSOLE_UART_NUM=0

# FreeRTOS: тик 1000 Гц — нужен для устойчивых 20 Гц MANUAL_CONTROL (NFR-4)
# и коротких таймаутов дребезга/удержания.
CONFIG_FREERTOS_HZ=1000

# nunchuk_hal.c использует legacy driver/i2c.h (см. комментарий в файле —
# выбран ради совместимости между версиями IDF). В ESP-IDF 6.0.1 этот
# драйвер помечен EOL (будет удалён в 7.0) и без этой опции превращает
# предупреждение в ошибку сборки (-Werror). Точечный, осознанный компромисс,
# не постоянное решение — миграция на driver/i2c_master.h требуется до
# перехода проекта на IDF 7.x.
CONFIG_I2C_SUPPRESS_DEPRECATE_WARN=y

# LVGL хранит RGB565 в порядке байт хоста (little-endian на ESP32), а
# ST7789 по SPI ожидает старший байт первым (big-endian). Без обмена
# байты каждого пикселя переставлены: на тексте почти незаметно, на
# сплошных цветных заливках даёт рябь/дизеринг — проверено на стенде.
CONFIG_LV_COLOR_16_SWAP=y
